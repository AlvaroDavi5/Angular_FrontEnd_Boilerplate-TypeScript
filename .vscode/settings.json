{
	// Editor
	"editor.insertSpaces": false,
	"editor.tabSize": 2,
	"editor.formatOnSave": true,
	"editor.wordWrap": "off",
	"editor.defaultFormatter": "vscode.typescript-language-features",
	"editor.codeActionsOnSave": {
		"source.fixAll": "explicit",
		"source.fixAll.oxc": "explicit",
		"source.organizeImports": "never",
		"source.removeUnusedImports": "always",
		"source.removeUnused.ts": "never"
	},
	"editor.fontFamily": "Fira Code",
	"editor.fontSize": 15,
	"editor.fontWeight": "400",
	"editor.fontLigatures": true,
	"editor.bracketPairColorization.enabled": true,
	"editor.guides.bracketPairs": "active",
	"editor.inlineSuggest.enabled": true,
	"editor.suggestSelection": "first",
	"editor.pasteAs.enabled": false,
	"editor.pasteAs.showPasteSelector": "never",
	"editor.stickyScroll.enabled": false,
	"editor.autoClosingBrackets": "always",
	"editor.minimap.enabled": true,
	"editor.unicodeHighlight.invisibleCharacters": false,
	"editor.unicodeHighlight.ambiguousCharacters": false,
	// Workbench
	"workbench.editor.restoreViewState": true,
	// Versioning
	"scm.defaultViewMode": "tree",
	"git.autofetch": true,
	"git.enableSmartCommit": true,
	"git.openRepositoryInParentFolders": "always",
	// Extensions
	"material-icon-theme.activeIconPack": "angular",
	"vsicons.presets.nestjs": false,
	"vsicons.presets.angular": true,
	"vsicons.presets.tsOfficial": true,
	"vsicons.presets.jsOfficial": true,
	"editorconfig.generateAuto": true,
	"editorconfig.template": "default",
	"oxc.enable.oxlint": true,
	"oxc.enable.oxfmt": true,
	"oxc.configPath": ".oxlintrc.json",
	"oxc.fmt.configPath": ".oxfmtrc.json",
	"diffEditor.ignoreTrimWhitespace": false,
	"js/ts.suggest.autoImports": true,
	"js/ts.suggestionActions.enabled": true,
	"js/ts.updateImportsOnFileMove.enabled": "always",
	"github.copilot.nextEditSuggestions.enabled": true,
	"[ignore]": {
		"editor.defaultFormatter": "EditorConfig.EditorConfig"
	},
	"[chatagent]": {
		"editor.defaultFormatter": "vscode.markdown-language-features"
	},
	"[prompt]": {
		"editor.defaultFormatter": "vscode.markdown-language-features"
	},
	"[instructions]": {
		"editor.defaultFormatter": "vscode.markdown-language-features"
	},
	"[skill]": {
		"editor.defaultFormatter": "vscode.markdown-language-features"
	},
	"[markdown]": {
		"editor.defaultFormatter": "vscode.markdown-language-features"
	},
	"[typescript]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[html]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[css]": {
		"editor.defaultFormatter": "oxc.oxc-vscode"
	},
	"[yaml]": {
		"editor.defaultFormatter": "redhat.vscode-yaml"
	},
	"[json]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "vscode.json-language-features"
	},
	"json.schemas": [
		{
			"fileMatch": [
				"/package.json"
			],
			"url": "https://json.schemastore.org/package",
			"schema": true
		}
	],
	"files.exclude": {
		"**/.classpath": true,
		"**/.project": true,
		"**/.settings": true,
		"**/.factorypath": true
	}
}